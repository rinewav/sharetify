{
  "name": "@sharetify/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/server/standalone.ts",
    "dev:electron": "pnpm build && electron dist/main.js",
    "build": "pnpm --filter @sharetify/shared build && tsc && cp src/server/*.py dist/server/ 2>/dev/null || true",
    "typecheck": "tsc --noEmit",
    "build:app": "pnpm --filter @sharetify/web build && pnpm build && node scripts/bundle-web.mjs",
    "dist": "pnpm build:app && electron-builder --publish never",
    "dist:mac": "pnpm build:app && pnpm prepare:mac && electron-builder --mac --publish never; pnpm prepare:dev",
    "dist:win": "pnpm build:app && pnpm prepare:win && electron-builder --win --publish never; pnpm prepare:dev",
    "dist:linux": "pnpm build:app && electron-builder --linux --publish never",
    "prepare:mac": "node scripts/prepare-native.mjs mac",
    "prepare:win": "node scripts/prepare-native.mjs win",
    "prepare:dev": "node scripts/prepare-native.mjs dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@sharetify/shared": "workspace:*",
    "hono": "^4.6.14",
    "node-datachannel": "^0.32.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "productName": "Sharetify",
  "description": "友だちとプレイリストを共有して、一緒に聴く",
  "build": {
    "appId": "app.sharetify.desktop",
    "productName": "Sharetify",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-datachannel/**",
      "dist/server/*.py"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "mergeASARs": true
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Audio",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sharetify"
    },
    "npmRebuild": false
  }
}
