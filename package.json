{
  "name": "musicshare",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "dev:hub": "pnpm --filter @musicshare/hub dev",
    "dev:web": "pnpm --filter @musicshare/web dev",
    "dev:desktop": "pnpm --filter @musicshare/desktop dev",
    "build": "pnpm --filter \"./packages/*\" build",
    "typecheck": "pnpm --filter \"./packages/*\" typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
